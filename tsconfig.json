{
  "compilerOptions": {
    "target": "es2018",            /* Compatibilidade com Node moderno */
    "module": "commonjs",          /* Gera módulos padrão Node */
    "declaration": true,           /* Gera arquivos .d.ts (IMPORTANTÍSSIMO) */
    "outDir": "./dist",            /* Pasta de saída */
    "strict": true,                /* Mais segurança no código */
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "**/*.test.ts"]
}